      "Assign_Morning_Care_Provider": {
        "type": "SetAttribute",
        "attribute": "care_provider_type",
        "direct_transition": "Assign_Morning_Provider_Details",
        "distributed_transition": [
          {
            "distribution": 0.8,
            "value": "nurse"
