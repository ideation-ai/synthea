              },
              {
                "attribute": "id",
                "distribution": {
                  "kind": "uniform",
                  "parameters": {
                    "low": 10000,
                    "high": 99999
                  }
                }
              }
            ]
          },
          {
            "condition": {
              "condition_type": "Attribute",
              "attribute": "care_provider_type",
              "operator": "==",
              "value": "therapist"
            },
            "distributions": [
              {
                "attribute": "name",
                "distribution": {
                  "kind": "direct",
                  "weights": [0.34, 0.33, 0.33],
