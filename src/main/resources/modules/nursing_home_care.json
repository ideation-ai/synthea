            "transition": "Assign_Serenity_Phone"
          }
        ]
      },
      
      "Assign_Oakwood_Phone": {
        "type": "SetAttribute",
        "attribute": "facility_phone",
        "value": "617-555-0111",
        "direct_transition": "Assign_Facility_Specialty"
      },
      
      "Assign_Riverside_Phone": {
        "type": "SetAttribute",
        "attribute": "facility_phone",
        "value": "617-555-0222",
        "direct_transition": "Assign_Facility_Specialty"
      },
      
      "Assign_Pinecrest_Phone": {
        "type": "SetAttribute",
        "attribute": "facility_phone",
        "value": "617-555-0333",
        "direct_transition": "Assign_Facility_Specialty"
      },
      
      "Assign_Maple_Grove_Phone": {
        "type": "SetAttribute",
        "attribute": "facility_phone",
        "value": "617-555-0444",
        "direct_transition": "Assign_Facility_Specialty"
      },
      
      "Assign_Serenity_Phone": {
        "type": "SetAttribute",
        "attribute": "facility_phone",
