            "distributions": [
              {
                "attribute": "name",
                "distribution": {
                  "kind": "direct",
                  "weights": [0.25, 0.25, 0.25, 0.25],
                  "values": ["Daniel Harris, CNA", "Olivia Martin, CNA", "Anthony Rodriguez, CNA", "Emma Thomas, CNA"]
                }
              },
              {
                "attribute": "title",
                "distribution": {
                  "kind": "direct",
                  "weights": [1.0],
                  "values": ["Certified Nursing Assistant"]
