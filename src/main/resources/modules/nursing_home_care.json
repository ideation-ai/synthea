{
    "name": "Nursing Home Care",
    "remarks": [
      "This module represents patients in nursing home settings and their ongoing care."
    ],
    "states": {
      "Initial": {
        "type": "Initial",
        "direct_transition": "Delay_For_Nursing_Home_Eligibility"
      },
      "Delay_For_Nursing_Home_Eligibility": {
        "type": "Delay",
        "range": {
          "low": 70,
          "high": 85,
          "unit": "years"
        },
        "direct_transition": "Nursing_Home_Eligibility"
      },
      "Nursing_Home_Eligibility": {
        "type": "Simple",
        "distributed_transition": [
          {
            "distribution": 0.6,
            "transition": "Admit_To_Nursing_Home"
          },
          {
            "distribution": 0.4,
            "transition": "Terminal"
          }
        ]
      },
      "Admit_To_Nursing_Home": {
        "type": "SetAttribute",
        "attribute": "care_setting",
        "value": "nursing_home",
        "direct_transition": "Assign_Nursing_Facility"
      },
      
      "Assign_Nursing_Facility": {
        "type": "SetAttribute",
        "attribute": "nursing_facility",
        "direct_transition": "Assign_Facility_Address",
        "distributed_transition": [
          {
            "distribution": 0.2,
            "value": "Oakwood Care Center"
          },
          {
            "distribution": 0.2,
            "value": "Riverside Nursing & Rehabilitation"
          },
          {
            "distribution": 0.2,
            "value": "Pinecrest Skilled Nursing Facility"
          },
          {
            "distribution": 0.2,
            "value": "Maple Grove Care Home"
          },
          {
            "distribution": 0.2,
            "value": "Serenity Hills Health Center"
          }
        ]
      },
      
      "Assign_Facility_Address": {
        "type": "SetAttribute",
        "attribute": "facility_address",
        "conditional_transition": [
          {
            "condition": {
              "condition_type": "Attribute",
              "attribute": "nursing_facility",
              "operator": "==",
              "value": "Oakwood Care Center"
            },
            "transition": "Assign_Oakwood_Address"
          },
          {
            "condition": {
              "condition_type": "Attribute",
              "attribute": "nursing_facility",
              "operator": "==",
              "value": "Riverside Nursing & Rehabilitation"
            },
            "transition": "Assign_Riverside_Address"
          },
          {
            "condition": {
              "condition_type": "Attribute",
              "attribute": "nursing_facility",
              "operator": "==",
              "value": "Pinecrest Skilled Nursing Facility"
            },
            "transition": "Assign_Pinecrest_Address"
          },
          {
            "condition": {
              "condition_type": "Attribute",
              "attribute": "nursing_facility",
              "operator": "==",
              "value": "Maple Grove Care Home"
            },
            "transition": "Assign_Maple_Grove_Address"
          },
          {
            "transition": "Assign_Serenity_Address"
          }
        ]
      },
      
      "Assign_Oakwood_Address": {
        "type": "SetAttribute",
        "attribute": "facility_address",
        "value": "123 Elder Street, Boston, MA 02108",
        "direct_transition": "Assign_Facility_Phone"
      },
      
      "Assign_Riverside_Address": {
        "type": "SetAttribute",
        "attribute": "facility_address",
        "value": "456 Health Avenue, Cambridge, MA 02142",
        "direct_transition": "Assign_Facility_Phone"
      },
      
      "Assign_Pinecrest_Address": {
        "type": "SetAttribute",
        "attribute": "facility_address",
