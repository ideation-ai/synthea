        "direct_transition": "Assign_Facility_Phone"
      },
      
      "Assign_Maple_Grove_Address": {
        "type": "SetAttribute",
        "attribute": "facility_address",
        "value": "101 Senior Parkway, Brookline, MA 02446",
        "direct_transition": "Assign_Facility_Phone"
      },
      
      "Assign_Serenity_Address": {
        "type": "SetAttribute",
